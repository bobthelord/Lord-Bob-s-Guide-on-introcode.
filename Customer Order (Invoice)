
def create_order(customer_name, *items, **kwargs):
    """
    customer_name: required
    *items: any number of food items ordered
    **kwargs: any extra order details like address, phone, notes, etc
    """
    print(f"========== NEW ORDER ==========")
    print(f"Customer: {customer_name}")

    # 1. Print all food items
    print("\nItems Ordered:")
    if items:
        for i, item in enumerate(items, 1):
            print(f"  {i}. {item}")
    else:
        print("  No items added")

    # 2. Print all extra details from kwargs
    print("\nOrder Details:")
    if kwargs:
        for key, value in kwargs.items():
            # make it look nice: delivery_address -> Delivery Address
            nice_key = key.replace("_", " ").title()
            print(f"  {nice_key}: {value}")
    else:
        print("  No extra details")

    # 3. Calculate a simple total
    price_per_item = 2000  # ₦2000 per item
    total = len(items) * price_per_item
    print(f"\nTotal: ₦{total}")
    print(f"==============================\n")

#
# # Example 1: Simple order
create_order(
    "Aisha Bello",
    "Jollof Rice and Chicken",
    "Chapman",
    delivery_address="12 Wuse 2, Abuja",
    phone="08031234567",
    payment_method="Transfer"
)
