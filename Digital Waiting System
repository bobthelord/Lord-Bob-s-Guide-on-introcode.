# # Digital Waiting System (Selective system)


def order_food(menu, choice):
    if choice in menu:
        print(f"You ordered {choice}. Please wait while it is prepared.")
    else:
        print("Sorry, that item is not on the menu.")

# --- Example Usage ---
menu = ["Rice", "Beans", "Bread", "Soup"]

order_food(menu, "Rice") # Valid order
order_food(menu, "Pizza") # Invalid order


