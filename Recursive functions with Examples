# # QUESTION 10
# # Recursive sum

def total(n):
    if n == 0:
        return 0

    return n + total(n-1)

print(total(5))

# # Recursive Countdown
def countdown(number):
    if number == 0:
        print("Blast Off")
        return
    print(number)
    countdown(number-1)

countdown(10)


# # Example 2
def countdown(timer):
    if timer == 0:
        timer = 1
        print("Go!")
        return
    print("Go!")
    countdown(timer - 1)
countdown(998)



# # QUESTION 12
# Recursive Fibonacci
def fibonacci(n):
    if n <= 0:
        return n
    return fibonacci(n-1) + fibonacci(n-2)

for i in range(10):
    print(fibonacci(i))

