# # Assigning Functions

# Example...1
def marks(name, *subject):
    total = 0

    for mark in subject:
        total += mark

    average = total / len(subject)
    print("Average marks of", name, "is", average)


# #Function calls.
marks("Bob", 20, 40)
marks("John", 25, 45, 50)

# #Example 2
def Mymarks (name, **subject):
    total = 0
    for sub in subject:
        subject_name = sub
        subject_marks = subject[sub]
        print(subject_name, "=", subject_marks)
        total = total + subject_marks
    print("total marks of", name, "is =", total)
Mymarks("Catherine", English = 52, Maths = 60, Science = 45)
Mymarks("Josephine", English = 62, Maths = 70, Science = 55)

# # Example 3
def greet_all(greeting, *names):
    for name in names:
        print(f"{greeting}, {name}!")


# Function call
greet_all("Greetings", "Aisha", "Bola", "Emeka")


# # example 4

def student_info(name, **details):
    print("Name:", name)

    print("Other Details:")
    for key, value in details.items():
        print(f"{key}: {value}")


# Function call (Block form)
student_info(
    "Bob",
    Age=20,
    Course="Computer Science",
    Level="200",
    State="Lagos"
)


# Call the function (Inline form)
student_info("Ada", age=16, school="GSS Abuja", hobby="Reading")
student_info("Tunde", class_="SS2", subject="Math")
student_info("Chioma")

